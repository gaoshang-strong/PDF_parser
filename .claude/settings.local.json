      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(python --version)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(black --check*)",
      "Bash(git *)",
      "Bash(/home/sgao30/micromamba/envs/PDF_parser/bin/python -c \"import requests; print\\('requests:', requests.__version__\\)\")",
      "Bash(/home/sgao30/micromamba/envs/PDF_parser/bin/python -m pip install -e \"/ShangGaoAIProjects/PDF_parser\" -q)",
      "Bash(/home/sgao30/micromamba/envs/PDF_parser/bin/python *)"
